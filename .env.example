# Control plane
HOST=0.0.0.0
PORT=8787
DATABASE_PATH=./data/ai-devops.db
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@aidevops.local
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional OpenAI-compatible model gateway.
# Without these values the Copilot runs in safe local-analysis mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Set to false only after replacing the demo repository and cloud accounts.
DEMO_MODE=true

# Tencent Cloud TCR namespace used in image tags (default: examplespace).
# CCR_NAMESPACE=examplespace

