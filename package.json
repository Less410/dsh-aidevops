{
  "name": "dsh-ai-devops",
  "version": "0.1.0",
  "description": "Bridge an AI DevOps control plane into DeepSeek Harness: native ai_devops_* tools for platform health, agent deployments, synced cloud resources and delivery tasks.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "dsh-ai-devops contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-ai-devops.git"
  },
  "homepage": "https://github.com/OWNER/dsh-ai-devops#readme",
  "bugs": {
    "url": "https://github.com/OWNER/dsh-ai-devops/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "ai-devops",
    "devops",
    "cloud",
    "agent"
  ],
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/plugin.test.mjs",
    "smoke": "node scripts/integration-smoke.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  }
